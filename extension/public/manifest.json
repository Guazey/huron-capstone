{
  "manifest_version": 3,
  "name": "Market Sidebar",
  "description": "Ask about a ticker while you trade. Live prices, information only.",
  "version": "0.1.0",
  "key": "",
  "action": {
    "default_title": "Open Market Sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://bedrock-agentcore.us-west-2.amazonaws.com/*",
    "https://*.auth.us-west-2.amazoncognito.com/*"
  ]
}