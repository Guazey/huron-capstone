{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what the sidebar UI calls: hide its window and open HTTPS links in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-hide",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
